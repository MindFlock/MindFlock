# MindFlock configuration (ADVANCED / OPTIONAL).
#
# You usually do NOT need this file. The recommended way to configure MindFlock
# is the web UI: the Settings dialog (the ⚙ button) for the app itself, plus the
# Intake dialog (Alt+I) for the ticketing / PR-review / issue-handling keys below.
# Both write secrets and settings to ~/.mindflock/settings.json (mode 0600,
# never committed).
#
# Every value below can instead be set in the web UI or via an environment
# variable. Resolution order for each field is:
#
#     environment variable  →  ~/.mindflock/settings.json  →  this config.toml  →  built-in default
#
# So this file is only an "advanced override": handy for headless / scripted
# runs where editing a file is easier than clicking the UI. To use it, copy this
# to `config.toml` (already gitignored) and fill in your values.

# Ticketing sources — one [[ticketing.source]] block per connected tracker.
# provider ∈ github_issues | shortcut | jira | linear | asana. Each provider
# reads the credential subset it needs (see docs/configuration.md). PREFER the
# Intake dialog (Intake → Tickets) or $MINDFLOCK_TICKET_* env vars over committing
# secrets here.
#
# The shortest possible source is GitHub Issues, which needs NO fields at all:
# its token comes from your GitHub connection (or `gh auth token`) and its repo
# from [repository].url, or this checkout's `origin` if that is unset too.
#
#   [[ticketing.source]]
#   provider = "github_issues"
#
[[ticketing.source]]
provider = "shortcut"
# Shortcut API token — create one at
# https://app.shortcut.com/settings/account/api-tokens
api_token = ""
# Your Shortcut member UUID — tickets owned by this member are the ones the
# pipeline processes. UI field: Intake → Tickets → Member ID.
member_id = ""
poll_interval_seconds = 20
# Optional: only ingest stories in this workflow state.
# workflow_state_id = 500000007
# Optional: clone URL this source's tickets provision into (defaults to
# [repository].url).
# repo_url = ""
# Optional: which agent CLI this source's sessions run — claude | codex | aider |
# goose | opencode | cline | antigravity, or any provider you defined yourself.
# Unset falls back to [mindflock].agent and then the app's default program, so
# leaving it out changes nothing. Set it per source to route queues to different
# CLIs — e.g. one team's tickets on a hosted CLI and a compliance queue on a
# fully local model (see [local_model] below).
# agent = "codex"

[repository]
# The repo MindFlock provisions worktrees/clones from. Env: $MINDFLOCK_REPO_URL
# SSH and HTTPS are both fully supported, and this URL is used VERBATIM —
# MindFlock never rewrites your remote. Either spelling works:
#   url = "git@github.com:org/repo.git"        # SSH
#   url = "https://github.com/org/repo.git"    # HTTPS
url = ""
# Which transport to clone with when MindFlock only knows a repo by its
# "owner/name" slug (PR review and issue handling discover work that way).
# Env: $MINDFLOCK_GIT_TRANSPORT
#   "auto"  (default) match the transport of `url` above when it names the same
#           repo — so an SSH checkout keeps using SSH — else HTTPS.
#   "ssh"   always clone over SSH (git@host:owner/repo.git).
#   "https" always clone over HTTPS.
# An unrecognized value falls back to "auto". Your own git
# `url.<base>.insteadOf` rewrites still apply on top of whatever is chosen.
git_transport = "auto"
# Where per-session workspaces are created (relative to this file). Env: $MINDFLOCK_WORKSPACE_DIR
workspace_dir = "./workspaces"

[validation]
min_description_length = 20

[logging]
log_file = "./logs/pipeline.log"
log_level = "INFO"

[workspace]
# Shell commands run (in order) in every freshly provisioned workspace. When
# unset, they are auto-detected from the workspace contents: a uv/Python
# project gets `uv sync --all-groups` (plus `uv run pre-commit install` when a
# .pre-commit-config.yaml is present); other project types get none. Set an
# explicit list to override, or [] to disable setup entirely.
# setup_commands = ["npm ci", "npm run build"]

# Warm cache seeds: host-side artifacts copied into each fresh workspace so
# work starts warm instead of cold — a testmon DB, a Go build cache, a
# compiled-deps tarball, anything file-shaped. Seeding never overwrites a file
# already present in the workspace. Give a cache a refresh_command and a
# background refresher keeps the seed fresh: it tracks refresh_branch in a
# long-lived workspace, runs the setup commands + refresh_command every
# refresh_interval_seconds, and publishes the artifact back to seed_path.
# [[workspace.cache]]
# name = "testmon"
# seed_path = "./.cache/testmondata"      # host-side warm copy
# workspace_path = ".testmondata"         # where it lands inside a workspace
# refresh_enabled = true
# refresh_branch = "main"
# refresh_interval_seconds = 3600
# refresh_command = "uv run --group test pytest --testmon -q"
# env = { TESTMON_ENV = "shared" }        # env the cache's tooling needs pinned

[github]
# Repos the PR-monitor watches, each as "owner/name". Env (single repo):
# $MINDFLOCK_GITHUB_REPO
repos = []
# Base branch PRs are compared against. Env: $MINDFLOCK_BASE_BRANCH
base_branch = "main"
min_age_minutes = 15
poll_interval_seconds = 60
enabled = true
skip_authors = []
# GitHub token. Leave blank to fall back to $GH_TOKEN / $GITHUB_TOKEN /
# `gh auth token`. PREFER those over committing a PAT here.
token = ""
# --- Automated issue handling (opt-in, OFF by default) ----------------------
# Newly opened issues in issue_repos each get their own coding session on a
# fresh branch. issue_repos is a separate list from the PR-review `repos`
# above, and these knobs are independent of the PR-review ones.
# issues_enabled = false
# issue_repos = []                 # ["owner/name", ...] to watch for new issues
# issue_min_age_minutes = 15       # ignore issues younger than this
# issue_poll_interval_seconds = 60
# issue_skip_authors = []          # ["login", ...] issue authors to ignore
# --- Per-repo overrides (optional) ------------------------------------------
# Each watched repo is its own card in the Intake dialog (Intake → Pull requests /
# Issues), so each can carry its own agent CLI, base branch, grace period and
# skip list. These tables hold only the deviations: a key you omit inherits the
# flat field above, and so does a key left blank or empty (0 is a real value —
# no grace period at all). Keyed by the "owner/name" slug, quoted because of
# the slash. Keep them LAST inside [github]: after one of these headers, every
# bare key belongs to IT rather than to [github].
#
#   [github.repo_settings."owner/name"]      # PR review, one table per repo
#   agent = "codex"                  # only this repo's reviews run on codex
#   base_branch = "develop"          # its PRs target develop, not `main` above
#   min_age_minutes = 0              # review it as soon as the PR opens
#   skip_authors = ["renovate[bot]"] # whose review comments to ignore here
#
# The issue-handling twin takes the same keys minus base_branch, which it never
# honours — an issue session always branches off the repo's own default:
#
#   [github.issue_repo_settings."owner/name"]
#   agent = "aider"                  # only this repo's issues run on aider
#   min_age_minutes = 60             # let issues here settle for an hour
#   skip_authors = ["renovate[bot]"] # whose issues to ignore here

[mindflock]
# Engine integration (DEFAULT ON, including when this whole section is absent):
# each ticket becomes a real MindFlock session — worktree + branch + seeded agent,
# shown in the app grid with the stage badge and the commit -> push -> PR bar.
# The bridge is in-process, so this needs no running server and works headless.
# Set false to revert to the standalone path: a detached tmux session plus an OS
# terminal tab, with no app session.
enabled = true
# "worktree" (fast worktree off a canonical clone) or "clone" (full standalone).
mode = "worktree"
# Open the workspace in Cursor once provisioned (best-effort; no-op without `cursor`).
open_cursor = true
# Launch the agent with the CLI's own skip-all-prompts flag so a fresh worktree
# path doesn't re-prompt the per-folder trust gate. The exact flag comes from the
# CLI's provider (claude: --dangerously-skip-permissions, codex:
# --dangerously-bypass-approvals-and-sandbox, aider: --yes-always; goose and
# cline have none and get nothing appended).
skip_permissions = true
# Which agent CLI ingested sessions run when their source names none — i.e. the
# ingestion-wide default, also used by PR review and issue handling, which have
# no source of their own. Env: $MINDFLOCK_INGESTION_AGENT
# Unset = the app's configured default program (unchanged behaviour).
# agent = "codex"

# --- Local model (privacy / no-subscription path) -----------------------------
# NOT read from config.toml — set it in the Settings UI (Local model) so the
# server can probe your server and list its models. Documented here for
# reference; it lives in ~/.mindflock/settings.json as:
#
#   [local_model]
#   enabled  = true
#   runtime  = "ollama"          # ollama | lmstudio | custom (OpenAI-compatible)
#   base_url = ""                # blank = that runtime's documented default
#   model    = "qwen2.5-coder:7b"
#
# With this on, the session's CLI is pointed at your own server: no subscription,
# no API key, and nothing you type or edit leaves the machine. Supported by
# codex, aider and goose (each has native local-model support). Claude Code
# speaks only the Anthropic API, so sessions on it keep using that —
# `mindflock doctor` says so out loud rather than letting it pass silently.

# --- Platform (Windows / WSL only) ------------------------------------------
# These have no effect on native Linux/macOS. NOTE: unlike the sections above,
# platform settings are NOT read from this config.toml — set them in the
# Settings UI (Platform section) or via the environment variables below:
#   wsl_distro : name for `wsl.exe -d <distro>`   Env $MINDFLOCK_WSL_DISTRO  (default "Ubuntu")
#   wt_command : Windows Terminal executable       Env $MINDFLOCK_WT_COMMAND  (default "wt.exe")
