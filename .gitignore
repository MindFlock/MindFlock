# --- Project-specific ---
config.toml
config.local.toml
workspaces/
logs/
*.log
.mindflock-pipeline.lock
# runtime/ephemeral pipeline activity file (ticket/pr/issue busy state) — not config
.mindflock-pipeline-activity.json
# per-repo scratch files written by the guided commit flow
.mindflock_*
# local pre-commit hook workdir
.precommit-local/

# Windows/WSL download metadata
*:Zone.Identifier

# Local logo/art drafts (large binaries — keep out of the repo; ship real
# assets under docs/ or electron/ deliberately)
/Birds*.png
/temp_logo.png

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
# ...except electron-builder's buildResources dir, which is hand-written
# source (the NSIS installer customization), not build output.
!/electron/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root so these Python-build dirs don't swallow source
# directories that happen to be named lib/ (e.g. frontend/src/lib/).
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# uv
.uv/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Type checkers / linters
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints
profile_default/
ipython_config.py

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Secrets / env files ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
# secrets.py is a source module (the secret *resolver*), not secret data — keep it tracked
!secrets.py
state.json
# Atomic writes land next to their target first (config.py names the temp
# "<file>.tmp.<rand>", settings.py ".settings.*.tmp"), so a `git add -A` that
# happens to race a save would otherwise stage live session/settings state.
*.tmp.*
*.tmp
.gitnexus
.claude
# generated by `gitnexus analyze` (local code-intelligence context)
CLAUDE.md
# --- Frontend build workspace ---
frontend/node_modules/
# Vite build artifacts land in backend/web/static/ (committed); the
# sourcemap is dev convenience only
backend/web/static/app.js.map
