{
  "name": "mindflock-desktop",
  "productName": "MindFlock",
  "version": "0.10.3",
  "license": "Apache-2.0",
  "private": true,
  "description": "Native desktop shell for the MindFlock web UI (Electron).",
  "author": "MindFlock <security@mindflock.ai>",
  "homepage": "https://github.com/MindFlock/MindFlock",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ai.mindflock.desktop",
    "productName": "MindFlock",
    "files": [
      "main.js",
      "preload.js",
      "logger.js",
      "firstlaunch.js",
      "update.js",
      "offline.html",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../install.sh",
        "to": "install.sh"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "MindFlock-Setup.exe"
    },
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MindFlock listens only while you click or hold the mic to talk to a session.",
        "NSSpeechRecognitionUsageDescription": "MindFlock turns what you say to a session into text with macOS speech recognition."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "MindFlock.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "artifactName": "MindFlock.AppImage"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MindFlock"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MindFlock",
        "repo": "MindFlock",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
