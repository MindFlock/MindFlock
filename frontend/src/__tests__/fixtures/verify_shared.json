              "s1": {"result": "blocked", "note": "needs you: run aws sso login", "at": 102, "by": "agent"},
              "s2": {"result": "blocked", "note": "needs a screen", "at": 102, "by": "agent"}
            }
          }
        ]
      },
      "current": 0,
      "open_human": ["s1", "s2"]
