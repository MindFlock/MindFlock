{
  "_doc": "Plans the server (tests/unit/test_verify_shared_fixture.py: test_plans._current_run / open_human_steps) and the UI model (verifySharedFixture.test.ts: latestRun / openHumanSteps) must answer the same about. `current` is the index of the run each side treats as the current one (null: none); `open_human` the steps a person still owes.",
  "cases": [
    {
      "name": "progress cells of a run released without a report are not checked",
      "why": "sc-25247: the session closed mid re-walk; every cell was the agent's progress note 'in progress: re-walking now'. Only the human step still asks.",
      "plan": {
        "id": "sc-1",
        "state": "generated",
        "live_at": 0,
        "run_session": "",
        "steps": [
          {"id": "s1", "text": "Call the API", "expect": "200", "actor": "agent"},
          {"id": "s2", "text": "Look at it", "expect": "Right", "actor": "human"}
        ],
        "runs": [
          {
            "at": 100, "by": "agent", "session": "sc-1", "in_session": true, "prelive": true,
            "progress_at": 101,
            "results": {
              "s1": {"result": "blocked", "note": "in progress: re-walking now", "at": 101, "by": "agent", "progress": true},
              "s2": {"result": "blocked", "note": "in progress: re-walking now", "at": 101, "by": "agent", "progress": true}
            }
          }
        ]
      },
      "current": 0,
      "open_human": ["s2"]
    },
    {
      "name": "a finished report's handover still asks",
      "why": "'needs you: …' written in the agent's finished report is a real request to a person.",
